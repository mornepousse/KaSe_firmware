CONFIG_KASE_DEVICE_ROLE_NIPHAR_SLAVE=y

# Pas de BLE : le budget d'alimentation l'interdit (HT7833, pics radio hors
# budget). La config et les mises à jour passent par USB.
# KASE_HAS_BLE est un bool SANS prompt (main/Kconfig.projbuild) : il n'est PAS
# surchargeable ici, le gate réel est le `default n if KASE_DEVICE_ROLE_NIPHAR_SLAVE`
# dans le Kconfig. CONFIG_BT_ENABLED=n coupe la pile Bluedroid elle-même
# (héritée de sdkconfig.defaults) — c'est ce qui a un effet.
CONFIG_BT_ENABLED=n

# La droite n'a pas d'USB utile en production (charge seulement, pas de HID) :
# une console au connecteur de prog est précieuse au bring-up.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Module réellement posé : ESP32-S3-WROOM-1 N16R8 (16 MB flash / 8 MB PSRAM).
# Constaté à l'esptool sur la moitié GAUCHE au bring-up du 2026-09-01 ; la
# droite n'a pas encore été lue, on suppose le même BOM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bring-up 2026-09-05 : la droite scanne desormais sa matrice, et chaque
# changement sort en clair sur la console du connecteur de prog. C'est le seul
# moyen de verifier la table de brochage DROITE contre le contrat materiel —
# elle differe de la gauche par des permutations de routage, et aucune
# compilation ne detecte une inversion (risque R3 de la spec).
# A retirer une fois le brochage valide : trop lent pour de la frappe reelle.
CONFIG_KASE_MATRIX_LOG_CONSOLE=y
