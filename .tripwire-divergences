# Écarts assumés du tripwire KaSe. Format : fichier<TAB>motif<TAB>pourquoi.
# Une ligne perdue = check rouge : son diff est le mécanisme de review.
scripts/check.sh	--fast|--host-only)	dialecte KaSe : --host-only = --fast standard. Référencé par README, CLAUDE.md, sept plans docs/superpowers et .claude/settings.local.json
scripts/check.sh	--variant|--board)	dialecte KaSe : --board = --variant standard. Même surface de référence que l'alias --host-only
scripts/check.sh	export IDF_CCACHE_ENABLE=1	préambule projet : les 7 boards partagent la plupart des composants, le cache croisé divise le temps du build full
scripts/check.sh	command -v idf.py	un outil absent n'est pas une régression : sans devshell la phase de build se saute en l'annonçant au lieu de rendre un rouge indiscernable d'un code cassé (doctrine v0.12.0)
scripts/hooks/cc_session_start.sh	.kase-board	fichier de variante custom, antérieur à .tripwire-variant et référencé par .esp-dev.yml, CLAUDE.md et l'agent kase-board-variant
