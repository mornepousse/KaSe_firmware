CONFIG_KASE_DEVICE_ROLE_KEYBOARD=y
CONFIG_KASE_NIPHAR_MASTER=y

# Pas de BLE : le budget d'alimentation l'interdit (HT7833, pics radio hors
# budget). La config et les mises à jour passent par USB.
# KASE_HAS_BLE est un bool SANS prompt (main/Kconfig.projbuild) : il n'est PAS
# surchargeable ici, le gate réel est le `default n if KASE_NIPHAR_MASTER` dans
# le Kconfig. CONFIG_BT_ENABLED=n coupe la pile Bluedroid elle-même (héritée de
# sdkconfig.defaults) — c'est ce qui a un effet.
CONFIG_BT_ENABLED=n

# La gauche est le maître (moteur keymap + trackpad) : c'est la moitié dont les
# logs comptent le plus. GPIO43/44 sont le connecteur de prog dédié sur
# Niphargus, jamais la matrice (cf. boards/niphar_left/board.h) — le
# CONFIG_ESP_CONSOLE_NONE de la base ne vise que la matrice du V2 et n'a pas
# lieu de s'appliquer ici.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Module réellement posé : ESP32-S3-WROOM-1 N16R8 (16 MB flash / 8 MB PSRAM),
# constaté à l'esptool au bring-up du 2026-09-01.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bring-up 2026-09-01 : verifier que la nRF24 repond sur le SPI.
# DESACTIVE le 2026-09-05 : depuis que KASE_KBD_WIRELESS est actif, kbd_relay_tx
# initialise deja la radio et logue son propre "probe csn=". Le laisser actif
# double l'init du bus SPI ("spi_bus_initialize: SPI bus already initialized")
# et brouille le diagnostic. L'option reste dans l'arbre pour un futur bring-up
# de la moitie droite, qui n'a pas encore de consommateur RF.
# COUPE quand HALF_LINK_RX est actif : rf_probe reinitialise la radio avec SON
# canal (0x4C) et SON adresse, ecrasant la config du recepteur de lien pose
# juste avant. La gauche ecoutait alors le canal du dongle et n'acquittait rien
# de ce que la droite emettait sur 0x4F. Une radio, un maitre.
# CONFIG_KASE_NRF_PROBE=y

# B4 — relais HID vers le dongle. Le routage est USB-first
# (comm/usb/usb_presence.c : tud_mounted) : USB branche -> HID par USB, USB
# absent -> radio vers le slot clavier du dongle. Pas d'ESP-NOW ni de WiFi,
# malgre l'intitule du Kconfig qui est un vestige.
# ETAPE 1 de B3 : la gauche ECOUTE la droite. Le relais vers le dongle est
# coupe — la meme radio ne peut pas faire les deux, c'est tout le risque R1.
# On prouve d'abord que le lien porte ; la bascule PRX/PTX vient ensuite.
# CONFIG_KASE_KBD_WIRELESS=y
CONFIG_KASE_HALF_LINK_RX=y

# Banc du 2026-09-05 : l'alimentation batterie ne fonctionne pas, donc
# debrancher l'USB pour faire basculer le routage n'est pas possible. On force
# le HID sur la radio, USB branche, pour eprouver le lien vers le dongle.
# A RETIRER une fois l'alimentation batterie reparee : tant que c'est actif, la
# moitie gauche ne tape plus par son propre USB.
# CONFIG_KASE_RF_FORCE_ROUTE=y   (sans relais, le forcage n'a plus d'objet)
